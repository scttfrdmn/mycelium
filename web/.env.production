# Production portal config (spore.host/app) — committed on purpose.
#
# Every value here is a PUBLIC identifier that already ships inside the built
# bundle a browser downloads: an OAuth public-client id, role ARNs the browser
# names when it federates, and public HTTPS endpoints. None is a secret (the
# portal holds no secret — it federates the visitor's own institutional identity
# into their own AWS account). Committing them means a CI build produces the same
# portal a local `npm run build` does; before this, .env was gitignored and a
# CI-built portal shipped an EMPTY client id and silently couldn't sign anyone in.
#
# Vite loads .env.production after .env in a production build, so these win over
# any local .env when running `npm run build`. Use .env.local for local-only
# experiments (e.g. pointing at a scratch account).

# The portal's Globus public-client UUID (aud) — the "spore.host portal" app.
VITE_GLOBUS_CLIENT_ID=47faedb8-8418-457e-9c37-aedaf6b6da3c

# The Globus-federated launch role (portal-oidc role_arn output, dev account).
VITE_ROLE_ARN=arn:aws:iam::435415984226:role/spore-portal-launch

# Region instances launch in.
VITE_AWS_REGION=us-east-1

# Shared dashboard-api base (catalog, cost-history, teams, Slack).
VITE_API_BASE=https://api.spore.host

# BYOA onboarding (Connect account surface) — infra/tofu/portal-phone-home outputs.
VITE_PHONE_HOME_ROLE_ARN=arn:aws:iam::966362334030:role/PortalPhoneHomeLambdaRole
VITE_PHONE_HOME_URL=https://omnvm7osdhhnr2f7qm4xghz2xq0txwjl.lambda-url.us-east-1.on.aws/
